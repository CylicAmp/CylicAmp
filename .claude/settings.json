{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/git_identity.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/owner_record.py\" --hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
